# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# Task 1 vision tier (python run_pipeline.py ... --vlm). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# VLM_PROVIDER=auto            # auto | gemini | claude
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.8-flash
# VLM_TIMEOUT_S=45

# Parallel page workers: Redis broker (docker compose up -d). Leave unset for the zero-setup
# local filesystem broker (one worker process with N page slots).
# CELERY_BROKER_URL=redis://localhost:6379/0

# Claude alternative for Task 1 (--vlm with VLM_PROVIDER=claude) and Task 2 (--live)
# ANTHROPIC_API_KEY=
